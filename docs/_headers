# This is used only with Cloudflare Workers. 
#
# 6hr	12hr	1day 	2day	3day	4day	1wk		2wk		4wk
# 21600	43200	86400	172800	259200	345600	604800	1209600	2419200

##########
# Cache-control

#

#
# Home (html) for 6 hours
/
	! Cache-Control
	Cache-Control: public, max-age=21600

# Sitewide: this sets everything for 3 days. But, subsequent rules replace this. In the end, this
# only applies to the files in the home directory (but not / itself, the html. That rule may apply
# first. So, this one replaces any existing cache-control too.).
/*
	! Cache-Control
	Cache-Control: public, max-age=259200

	#
	# Set the sitewide security headers too
	Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=()
	Referrer-Policy: strict-origin-when-cross-origin
	X-Content-Type-Options: nosniff
	X-Frame-Options: DENY
	X-XSS-Protection: 1; mode=block
	Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';  img-src 'self';  object-src 'none'; frame-ancestors 'none'; base-uri 'self'

# Starting here, the default (3-day) cache is replaced for everything not in the home directory 
# (and not /index.html)

#
# Resources (html) for 12 hours
/resources/*
	! Cache-Control
	Cache-Control: public, max-age=43200

#
# Cache image files for four days
/images/*
	! Cache-Control
	Cache-Control: public, max-age=345600

#
# Cache files for 1 week (I could probably do 4).
/files/*
	! Cache-Control
	Cache-Control: public, max-age=604800

#
# Cache css 2 days (I should do 4 eventually, or a week, then a month. I can bust the cache.)
/css/*
	! Cache-Control
	Cache-Control: public, max-age=172800
	
	# Don't cache css long if changing style rapidly
	# ! Cache-Control
	# Cache-Control: public, max-age=300

#
# Cache js 4 weeks (darkmode.js almost never changes. I can bust the cache with the url.)
/js/*
	! Cache-Control
	Cache-Control: public, max-age=2419200



