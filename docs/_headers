# This is used only with Cloudflare Workers. 
#
# 6hr	12hr	1day 	2day	3day	4day	1wk		2wk		4wk
# 21600	43200	86400	172800	259200	345600	604800	1209600	2419200

#**************
# Cache-control
#
# I might want to use Cache-Control: public, max-age=0, must-revalidate
#
# ! Cache-Control to remove/replace value


# Home (non-html files) for 1 week
/ads.txt
	Cache-Control: public, max-age=604800
/android-chrome-192x192.png
	Cache-Control: public, max-age=604800
/android-chrome-512x512.png
	Cache-Control: public, max-age=604800
/app-ads.txt
	Cache-Control: public, max-age=604800
/apple-touch-icon.png
	Cache-Control: public, max-age=604800
/favicon.ico
	Cache-Control: public, max-age=604800
/favicon-16x16.png
	Cache-Control: public, max-age=604800
/favicon-32x32.png
	Cache-Control: public, max-age=604800
/icon.svg
	Cache-Control: public, max-age=604800
/LICENSE.txt
	Cache-Control: public, max-age=604800
/llms.txt
	Cache-Control: public, max-age=604800
/site.webmanifest
	Cache-Control: public, max-age=604800

#
# Home (html) for 1 day
/
	Cache-Control: public, max-age=86400

#
# Resources (html) for 1 day
/resources/*
	Cache-Control: public, max-age=86400

#
# Cache image files for four days
/images/*
	Cache-Control: public, max-age=345600

#
# Cache files for 1 week (I could probably do 4).
/files/*
	Cache-Control: public, max-age=604800

#
# Cache css 2 days (I should do 4 eventually, or a week, then a month. I can bust the cache.)
/css/*
	Cache-Control: public, max-age=172800
	
	# Don't cache css long if changing style rapidly
	# Cache-Control: public, max-age=300

#
# Cache js 4 weeks (darkmode.js almost never changes. I can bust the cache with the url.)
/js/*
	Cache-Control: public, max-age=2419200


#
# Security headers (sitewide)
/*
	Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=()
	Referrer-Policy: strict-origin-when-cross-origin
	X-Content-Type-Options: nosniff
	X-Frame-Options: DENY
	X-XSS-Protection: 1; mode=block
	Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';  img-src 'self';  object-src 'none'; frame-ancestors 'none'; base-uri 'self'

/resources/collars-leashes/hot-knife/
	! Content-Security-Policy
	Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline';  img-src 'self';  object-src 'none'; frame-ancestors 'none'; base-uri 'self'

