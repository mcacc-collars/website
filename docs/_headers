#------------------------
# Cache /image files for four days
/images/*
	Cache-Control: public, max-age=345600
	Cross-Origin-Resource-Policy: same-site

/images/*.jpg
	Content-Type: image/jpeg
/images/*.webp
	Content-Type: image/webp
/images/*.gif
	Content-Type: image/gif
/images/*.svg
	Content-Type: image/svg+xml; charset=utf-8
	Content-Disposition: inline
	Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; frame-ancestors 'none'; sandbox;

#------------------------
# Cache files for 1 week (I could probably do 4).
/files/*
	Cache-Control: public, max-age=604800


#------------------------
# Cache css 2 days (I should do 4 eventually, or a week, then a month. I can bust the cache.)
/css/*.css
	Cache-Control: public, max-age=172800
	Cross-Origin-Resource-Policy: same-site
	Content-Type: text/css; charset=utf-8

	# Don't cache css long if changing style rapidly
	# Cache-Control: public, max-age=300


#------------------------
# Cache js 4 weeks (darkmode.js almost never changes. I can bust the cache with the url.)
/js/*.js
	Cache-Control: public, max-age=2419200
	Cross-Origin-Resource-Policy: same-site
	Content-Type: text/javascript; charset=utf-8


