#------------------------
# Cache /image files 1 week
/images/*
	Cache-Control: public, max-age=604800
	Cross-Origin-Resource-Policy: same-site

/images-ref/*
	Cache-Control: public, max-age=604800
	Cross-Origin-Resource-Policy: same-site

/images*.jpg
	Content-Type: image/jpeg
/images*.webp
	Content-Type: image/webp
/images*.gif
	Content-Type: image/gif
/images*.svg
	Content-Type: image/svg+xml; charset=utf-8
	Content-Disposition: inline
	Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; frame-ancestors 'none'; sandbox;

#------------------------
# Cache files 1 week (I could probably do 4).
/files/*
	Cache-Control: public, max-age=604800


#------------------------
# Cache css 1 week (I should do a month. I can bust the cache.)
/css/*.css
	Cache-Control: public, max-age=604800
	Cross-Origin-Resource-Policy: same-site
	Content-Type: text/css; charset=utf-8

	# Don't cache css long if changing style rapidly
	# Cache-Control: public, max-age=300


#------------------------
# Cache js 4 weeks (darkmode.js almost never changes. I can bust the cache with the url.)
/js/*.js
	Cache-Control: public, max-age=2419200
	Cross-Origin-Resource-Policy: same-site
	Content-Type: text/javascript; charset=utf-8


#------------------------
# Canonicals for downloadable files
# - zips fon't get this.
# - I serve some pdfs made by Juki. If they're indexed, google complains there's
#   no cannonical. I don't want to say my copies are cannonical, nor do I want to
#   keep up with changes to Juki's served location. So, I say noindex.

/files/du1181n.pdf
	X-Robots-Tag: noindex

# This is a Juki manual I heavily modified to make english-only, more readible. I 
# think it's fair to index and make mine canonical.
/files/instruction_7K_english.pdf
	Link: <https://www.mcacc-collars.charity/files/instruction_7K_english.pdf>; rel="canonical"

# This is a Juki manual I edited to remove variations of the bn machine for
# simplicity. But, I don't think that's substantial enough to index and claim
# mine is canonical.
/files/instruction_eg-1900bn_ONLY.pdf
	 X-Robots-Tag: noindex

/files/juki-du1181-manual.pdf
	X-Robots-Tag: noindex


