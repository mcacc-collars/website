#------------------------
# Sitewide (security headers)
/*
	Referrer-Policy: strict-origin-when-cross-origin
	X-Content-Type-Options: nosniff
	Strict-Transport-Security: max-age=604800; includeSubDomains

# fallback: script-src 'unsafe-inline'
#		Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';  img-src 'self';  object-src 'none'; frame-ancestors 'none'; base-uri 'self'


